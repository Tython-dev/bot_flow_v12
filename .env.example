# Botpress Docker Environment Configuration

# PostgreSQL Database Password
POSTGRES_PASSWORD=botpress_secure_password_change_this

# External URL (Update with your domain)
EXTERNAL_URL=https://bot.tybotflow.com

# Botpress Log Level (debug, info, warn, error)
BP_LOG_LEVEL=info

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=

# Optional: Additional environment variables
# NODE_OPTIONS=--max-old-space-size=4096
