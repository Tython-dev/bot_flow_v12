# Botpress Docker Environment Configuration

# ========================================
# DATABASE CONFIGURATION
# ========================================

# Option 1: Use existing PostgreSQL on host (RECOMMENDED)
# Your existing database: psql -U elorchi -d botflow -h 127.0.0.1
DATABASE_URL=postgres://elorchi:your_postgres_password@host.docker.internal:5432/botflow
POSTGRES_PASSWORD=your_postgres_password

# Option 2: Use containerized PostgreSQL (uncomment to use)
# DATABASE_URL=postgres://botpress:botpress_secure_password@postgres:5432/botpress
# POSTGRES_PASSWORD=botpress_secure_password_change_this

# ========================================
# EXTERNAL URL
# ========================================
EXTERNAL_URL=https://bot.tybotflow.com

# Botpress Log Level (debug, info, warn, error)
BP_LOG_LEVEL=info

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=

# Optional: Additional environment variables
# NODE_OPTIONS=--max-old-space-size=4096
