# Botpress v12 Environment Variables (example)
# Copy to project root as `.env` and adjust

# Public URL where users access Botpress
EXTERNAL_URL=https://your-domain.com

# Botpress server port
BP_PORT=3000

# Force production mode
BP_PRODUCTION=true

# Optional: logging verbosity (0=info, 1=warn, 2=debug)
BP_LOG_LEVEL=0

# Optional: database (defaults to SQLite). Example to use Postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/botpress
# BP_DATABASE=postgres

# Optional: messaging
# MESSAGING_ENDPOINT=https://messaging.botpress.cloud
